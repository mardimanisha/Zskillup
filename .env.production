# Public build configuration for the GitHub Pages deployment.
# Nothing secret lives here - these are all NEXT_PUBLIC_ values baked into the
# client bundle, which is why this file is committed.

# Served from https://antaryam2003.github.io/zskillup-website/
NEXT_PUBLIC_SITE_URL=https://antaryam2003.github.io/zskillup-website
NEXT_PUBLIC_BASE_PATH=/zskillup-website

# GitHub Pages serves files only, so there is no /api/enquiry to POST to.
# This switches the enquiry form to composing a pre-filled email instead.
NEXT_PUBLIC_STATIC_EXPORT=true

# Supabase (public client config; access is enforced by Row Level Security).
# Required at build time: lib/supabase.ts throws on import if these are missing.
NEXT_PUBLIC_SUPABASE_URL=https://lulafagedlopgieagemf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx1bGFmYWdlZGxvcGdpZWFnZW1mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyNDc4NDksImV4cCI6MjA5NjgyMzg0OX0.fO5DxmfI3bLKGPWlB6084jdaAPGsOg1tjZMfrw5MZ1k

# Google Apps Script web app that appends enquiries to the Google Sheet.
# Public by design (it can only append rows); used on the static build.
NEXT_PUBLIC_SHEET_URL=https://script.google.com/macros/s/AKfycbzOqh5U5AZITsjimq2r4TwNI0VzbTK2U853uIrLIKztuK8PC0qOIUyotb8DFNlanrTkCA/exec
