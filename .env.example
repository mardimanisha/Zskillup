# Production origin. Drives canonical URLs, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.zskillup.com

# ---------------------------------------------------------------------------
# Supabase. Required for both the public site (blog/events/testimonials data)
# and the admin panel (/admin) to function - this is a static export with no
# server, so all reads AND writes go directly from the browser to Supabase.
# Safe to expose client-side: the anon key only grants what Row Level
# Security policies in supabase/schema.sql allow (public read, writes require
# an authenticated admin session).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://lulafagedlopgieagemf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx1bGFmYWdlZGxvcGdpZWFnZW1mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyNDc4NDksImV4cCI6MjA5NjgyMzg0OX0.fO5DxmfI3bLKGPWlB6084jdaAPGsOg1tjZMfrw5MZ1k

# ---------------------------------------------------------------------------
# Enquiry delivery. Set ONE of the following, or enquiries are only logged.
# ---------------------------------------------------------------------------

# Option A - POST the enquiry as JSON to any endpoint (Slack, Zapier, CRM).
# ENQUIRY_WEBHOOK_URL=

# Option B - deliver by email via Resend.
# RESEND_API_KEY=
# ENQUIRY_EMAIL_TO=hello@zskillup.com
# ENQUIRY_EMAIL_FROM=ZSkillup <noreply@zskillup.com>

# ---------------------------------------------------------------------------
# Statistics safety switch.
#
# Figures marked `verified: false` in content/stats.ts are hidden in production
# builds so an unvalidated claim cannot be published by accident. Set this to
# true ONLY to preview them in a production build - never on the live site until
# the numbers are confirmed. See CONTENT-TODO.md.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SHOW_UNVERIFIED_STATS=false
